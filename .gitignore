# Gitignore generated by Gemini CLI

# Build artifacts
build/
client/build/
server/build/

# Node modules
node_modules/
client/node_modules/

# Gradle
.gradle/
server/.gradle/
# build.gradle.kts is essential for the Kotlin DSL project and should be tracked.

# H2 Database files
data/
server/data/

# IDE files
.idea/
*.iml
*.ipr
*.iws

# Docker ignores
.dockerignore

# Logs
*.log
logs/

# Environment variables
.env
.env.*

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Compiled files (Java)
*.class
target/ # Maven target directory, if applicable

# Specific MD and TXT files to ignore as per user request
REPORT.md
async_communication_in_react.md
createDockerFile.md
fixed_extensions_details.md
functional_considerations.md
output.txt
project_considerations.md
server/READEME.md
server/init.md
server/page.md
server_readme_analysis_report.md
work_summary.md